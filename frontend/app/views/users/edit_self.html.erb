<%= setup_context :object => @user %>

<%= form_for @user, :as => "createuser", :url => {:action => :update_self}, :html => {:class => 'form-horizontal aspace-record-form'}.merge(update_monitor_params(@user)) do |f| %>
  <div class="d-flex">
    <div class="col-md-1"></div>
     <div class="col-md-11">
       <div class="record-toolbar d-flex flex-wrap">
         <%= button_confirm_action(
           "Reset MFA",
           url_for(:controller => :qsa_mfa, :action => :reset_mfa_for_current_user),
           {
             :class => "btn btn-sm btn-danger flex-item ml-auto",
             :"data-title" => "Reset Multi-Factor Authentication (MFA) for your account?",
             :"data-message" => "This will clear your existing MFA settings and require you to log back into ArchivesSpace",
             :"data-confirm-btn-label" => "Reset my Multi-Factor Authentication settings",
             :"data-confirm-btn-class" => "btn-primary",
           }
         )
         %>
       </div>
       <div class="record-pane">
         <%= link_to_help :topic => "user" %>
         <h2><%= t("user._frontend.section.edit_account") %></h2>
         <%= form_context :user, @user do |form| %>
           <%= render_aspace_partial :partial => "users/form", :locals => {:form => form} %>

           <div class="form-actions">
             <button id="create_account" type="submit" class="btn btn-primary"><%= t("user._frontend.section.edit_account_submit") %></button>
             <%= link_to t("actions.cancel"), {:controller => :welcome}, :class => "btn btn-cancel btn-default" %>
           </div>
         <% end %>
       </div>
     </div>
  </div>
<% end %>
